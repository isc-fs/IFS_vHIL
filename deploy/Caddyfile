# TLS reverse proxy in front of the web app (docs/deploy.md).
#
# VHIL_SITE / VHIL_EDITOR_SITE are Caddy site addresses:
#   vhil.example.org / vhil.example.org:5443   public: automatic HTTPS (Let's Encrypt)
#   localhost / localhost:5443                 local: HTTPS from Caddy's internal CA
#   http://localhost / http://localhost:5443   local: plain HTTP
#
# The editor (Pipeline Manager) has no login of its own. It is served on a
# second port of the same host, so the browser sends it the app's session
# cookie (cookies are per host, not per port), and every request to it is
# first checked against the API's /api/me: 2xx (a signed-in org member, or
# anyone in dev mode) passes, anything else is answered with the API's 401.
(common) {
	encode zstd gzip
	log {
		output stdout
		format console
	}
}

{$VHIL_SITE} {
	import common
	reverse_proxy api:8080
}

{$VHIL_EDITOR_SITE} {
	import common
	forward_auth api:8080 {
		uri /api/me
		# The check is a plain GET even when the request upgrades to a
		# WebSocket (the editor's socket.io); passed on, those headers make
		# the API answer /api/me as a WebSocket (403).
		header_up -Connection
		header_up -Upgrade
		header_up -Sec-WebSocket-*
	}
	reverse_proxy editor:5000
}
