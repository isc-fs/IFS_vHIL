# deploy/.env for deploy/compose.prod.yaml (docs/deploy.md). Copy this file to
# deploy/.env (git-ignored), fill it in, `chmod 600` it. No real secret ever
# goes into the example.

# -- images (docs/deploy.md, "Images") --------------------------------------------
# <VHIL_IMAGE>:<VHIL_TAG> and <VHIL_IMAGE>-editor:<VHIL_TAG>.
VHIL_IMAGE=ghcr.io/isc-fs/ifs-vhil
VHIL_TAG=latest

# -- the workspace clone (deploy/workspace.sh) ---------------------------------------
# The deployed version: a branch of the remote, a tag or a commit. Checked out
# (detached) on every `up`; pin a tag or commit to upgrade only on purpose.
VHIL_WORKSPACE_REF=dev
VHIL_WORKSPACE_REMOTE=https://github.com/isc-fs/IFS_vHIL.git
# Where saved branches are pushed and PRs opened (owner/name).
VHIL_GITHUB_REPO=isc-fs/IFS_vHIL
# Branch PRs target and new branches start from.
VHIL_BASE_BRANCH=dev

# -- where users reach it ---------------------------------------------------------
# Caddy site addresses: a domain gets automatic HTTPS (DNS A/AAAA -> this host,
# ports 80 and 443 open). The editor is the same host on a second port.
VHIL_SITE=vhil.example.org
VHIL_EDITOR_SITE=vhil.example.org:5443
# The same, as URLs the browser opens (no trailing /).
VHIL_PUBLIC_URL=https://vhil.example.org
VHIL_EDITOR_URL=https://vhil.example.org:5443
# Host ports the proxy publishes.
VHIL_HTTP_PORT=80
VHIL_HTTPS_PORT=443
VHIL_EDITOR_PORT=5443

# -- login (docs/development/web-app.md) ---------------------------------------------
# github: members of VHIL_GITHUB_ORG after GitHub login. dev: no login, anyone
# who reaches the proxy is "dev" - only for a local test, never on a network.
VHIL_AUTH=github
VHIL_GITHUB_ORG=isc-fs
# From the GitHub App (its OAuth client).
VHIL_GITHUB_CLIENT_ID=
VHIL_GITHUB_CLIENT_SECRET=
# >= 32 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
VHIL_SESSION_SECRET=

# -- GitHub App: pushes of saved branches, PRs -----------------------------------
VHIL_GITHUB_APP_ID=
# The App's private key, as a file in VHIL_SECRETS_DIR (mounted read-only).
VHIL_SECRETS_DIR=./secrets
VHIL_GITHUB_APP_KEY_FILE=github-app.pem
# Instead of the App, until it exists: a fine-grained token with contents +
# pull requests write on VHIL_GITHUB_REPO. Leave empty when the App is set.
VHIL_GITHUB_TOKEN=

# -- workers and limits --------------------------------------------------------------
# Concurrent runs. Each holds up to VHIL_WORKER_CPUS / VHIL_WORKER_MEMORY.
VHIL_WORKERS=2
VHIL_WORKER_CPUS=4
VHIL_WORKER_MEMORY=4g
VHIL_API_CPUS=2
VHIL_API_MEMORY=2g
VHIL_EDITOR_CPUS=1
VHIL_EDITOR_MEMORY=2g

# -- backups (deploy/backup.py) ----------------------------------------------------
# A named volume ("backups") or a host directory (absolute path) to copy off-host.
VHIL_BACKUP_DIR=/var/backups/ifs-vhil
VHIL_BACKUP_INTERVAL_H=24
VHIL_BACKUP_KEEP=14
