# deploy/.env for deploy/compose.prod.yaml (docs/deploy.md). Copy this file to
# deploy/.env (git-ignored), fill it in, `chmod 600` it. No real secret ever
# goes into the example, and no secret goes into deploy/.env either: secrets
# are files in VHIL_SECRETS_DIR (below), handed to the services as compose
# secrets, never as environment variables.

# -- images (docs/deploy.md, "Images") --------------------------------------------
# <VHIL_IMAGE>:<VHIL_TAG> and <VHIL_IMAGE>-editor:<VHIL_TAG>. Pin a dated
# tag, and the digests the registry gave each image when it was pushed
# (`docker buildx imagetools inspect <image>:<tag>`), written with their "@":
# a tag can be moved, a digest can't.
VHIL_IMAGE=ghcr.io/isc-fs/ifs-vhil
VHIL_TAG=latest
VHIL_DIGEST=
VHIL_EDITOR_DIGEST=
# e.g. VHIL_TAG=2026.10.04-d60336e
#      VHIL_DIGEST=@sha256:<64 hex>        VHIL_EDITOR_DIGEST=@sha256:<64 hex>

# -- the workspace clone (deploy/workspace.sh) ---------------------------------------
# The deployed version: a tag or a full commit sha (a branch works, but then
# every `up` deploys whatever the branch is at that moment). Checked out
# (detached) on every `up`. Required: the placeholder fails the workspace
# service until it is replaced.
VHIL_WORKSPACE_REF=REPLACE-with-a-release-tag-or-commit-sha
VHIL_WORKSPACE_REMOTE=https://github.com/isc-fs/IFS_vHIL.git
# Where saved branches are pushed and PRs opened (owner/name).
VHIL_GITHUB_REPO=isc-fs/IFS_vHIL
# Branch PRs target and new branches start from.
VHIL_BASE_BRANCH=dev

# -- where users reach it ---------------------------------------------------------
# Caddy site address: a domain gets automatic HTTPS (DNS A/AAAA -> this host,
# ports 80 and 443 open). The editor is on the same origin, under /editor/.
VHIL_SITE=vhil.example.org
# The same, as the URL the browser opens (no trailing /).
VHIL_PUBLIC_URL=https://vhil.example.org
# Host address and ports the proxy publishes (127.0.0.1 behind another proxy
# or for a local test).
VHIL_BIND_ADDR=0.0.0.0
VHIL_HTTP_PORT=80
VHIL_HTTPS_PORT=443
# HSTS max-age on HTTPS responses (seconds); 0 for a localhost site.
VHIL_HSTS_MAX_AGE=31536000

# -- login (docs/development/web-app.md) ---------------------------------------------
# github: members of VHIL_GITHUB_ORG after GitHub login. dev: no login, anyone
# who reaches the proxy is "dev" - only for a local test, never on a network.
VHIL_AUTH=github
VHIL_GITHUB_ORG=isc-fs
# GitHub logins (comma-separated) who may cancel anyone's run and move anyone's
# saved branch without a takeover.
VHIL_ADMINS=
# From the GitHub App (its OAuth client). Not a secret; its client secret is.
VHIL_GITHUB_CLIENT_ID=

# -- GitHub App: pushes of saved branches, PRs -----------------------------------
VHIL_GITHUB_APP_ID=

# -- secrets: files, not variables (docs/deploy.md, "Secrets") -------------------------
# A directory of files, each owned by uid 10001 and mode 0400; an unused one
# is an empty file (compose needs every file to exist):
#   session_secret         >= 32 random characters, changing it logs everyone out:
#                          python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   github_client_secret   the GitHub App's OAuth client secret
#   github-app.pem         the App's private key (name: VHIL_GITHUB_APP_KEY_FILE)
#   github_token           until the App exists: a fine-grained token, contents +
#                          pull requests write on VHIL_GITHUB_REPO; else empty
VHIL_SECRETS_DIR=./secrets
VHIL_GITHUB_APP_KEY_FILE=github-app.pem

# -- workers and limits --------------------------------------------------------------
# Concurrent runs. Each holds up to VHIL_WORKER_CPUS / VHIL_WORKER_MEMORY (its
# /tmp, VHIL_WORKER_TMP, counts against the memory) and VHIL_WORKER_PIDS.
VHIL_WORKERS=2
VHIL_WORKER_CPUS=4
VHIL_WORKER_MEMORY=4g
VHIL_WORKER_TMP=1g
VHIL_WORKER_PIDS=2048
# What runs may ask (docs/deploy.md, "Limits"): virtual time per run, active
# (queued + running) runs in all and per user, a run's trace and pytest output.
VHIL_MAX_VIRTUAL_MS=600000
VHIL_MAX_QUEUED=50
VHIL_MAX_QUEUED_PER_USER=10
VHIL_MAX_TRACE_MB=512
VHIL_MAX_OUTPUT_MB=64
# The firmware picker lists a repo's active branches: its default branch,
# dev/main, branches with an open PR, and heads within this many days.
VHIL_FIRMWARE_ACTIVE_DAYS=30
# Where workers (firmware clones) and the workspace fetch may connect, through
# the egress proxy: names, ".suffix" for subdomains; ports.
VHIL_EGRESS_ALLOW=github.com,.githubusercontent.com
VHIL_EGRESS_PORTS=443
VHIL_API_CPUS=2
VHIL_API_MEMORY=2g
VHIL_EDITOR_CPUS=1
VHIL_EDITOR_MEMORY=2g

# -- backups (deploy/backup.py) ----------------------------------------------------
# A named volume ("backups") or a host directory (absolute path) to copy off-host,
# encrypted (docs/deploy.md, "Off-host copies"). Snapshots are 0700/0600.
VHIL_BACKUP_DIR=/var/backups/ifs-vhil
VHIL_BACKUP_INTERVAL_H=24
VHIL_BACKUP_KEEP=14
