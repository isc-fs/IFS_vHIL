From 250cdccf79d48fe2bf09216424b6feea26876d0f Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Thu, 15 Oct 2026 11:20:49 +0200
Subject: [PATCH] [FIX] STM32_Timer: Count ARR + 1 values per update period

The counter's clock entry had ARR as its limit, so the update event came
every ARR counts: a timer with ARR = 999 at 1 MHz raised it every 999 us
instead of 1 ms (an STM32Cube HAL timebase ran 0.1 % fast), and TIMx_CNT
never read ARR. On the chip the counter counts from 0 to ARR and then
overflows to 0 (up), or from ARR to 0 and then underflows to ARR (down):
ARR + 1 values, so the update period is (ARR + 1) * (PSC + 1) timer
clocks (e.g. RM0468 44.3.2 "Counter modes", RM0090 18.3.2).

The entry's limit is now ARR + 1, wherever it is set (construction,
reset, an ARR write without preload, the update event's preload
transfer). Counting up, the entry's value is still the counter. Counting
down, a descending entry fires when it reaches 0 and reloads its limit,
so its value is the counter + 1: CNT reads and writes, UG's reload to ARR
and a DIR change go through a Counter property that maps the two. PWM
mode 1 now has a period of ARR + 1 counts, high for CCRx of them.
Centre-aligned counting is not modelled and is unchanged.

Tests: STM32_TimerTests (update period, prescaler, down-counting
underflow, PWM period); all four fail without this change.
---
 .../Peripherals/Timers/STM32_Timer.cs         |  48 +++++-
 .../Test/PeripheralsTests/STM32_TimerTests.cs | 159 ++++++++++++++++++
 2 files changed, 199 insertions(+), 8 deletions(-)
 create mode 100644 src/Emulator/Peripherals/Test/PeripheralsTests/STM32_TimerTests.cs

diff --git a/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs b/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
index 47a492f..1897d36 100644
--- a/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
+++ b/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
@@ -23,7 +23,8 @@ namespace Antmicro.Renode.Peripherals.Timers
     [AllowedTranslations(AllowedTranslation.ByteToDoubleWord | AllowedTranslation.WordToDoubleWord)]
     public class STM32_Timer : LimitTimer, IDoubleWordPeripheral, IKnownSize, INumberedGPIOOutput, IRegisterablePeripheral<IGPIOReceiver, NumberRegistrationPoint<int>>, IRegisterablePeripheral<IGPIOReceiver, NullRegistrationPoint>, IGPIOReceiver
     {
-        public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(machine.ClockSource, frequency, limit: initialLimit, direction: Direction.Ascending, enabled: false, eventEnabled: true, autoUpdate: false)
+        // The counter counts ARR + 1 values, 0 to ARR, so the clock entry's limit is ARR + 1 (see Counter).
+        public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(machine.ClockSource, frequency, limit: (ulong)initialLimit + 1, direction: Direction.Ascending, enabled: false, eventEnabled: true, autoUpdate: false)
         {
             this.machine = machine;
             sysbus = machine.GetSystemBus(this);
@@ -59,7 +60,7 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                     enableRequested = false;
                 }
 
-                Limit = autoReloadValue;
+                Limit = (ulong)autoReloadValue + 1;
                 this.Log(LogLevel.Noisy, "IRQ pending");
                 updateInterruptFlag = true;
 
@@ -158,7 +159,15 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                         {
                             return;
                         }
-                        Direction = val ? Direction.Descending : Direction.Ascending;
+                        // The counter keeps its value (see Counter)
+                        var direction = val ? Direction.Descending : Direction.Ascending;
+                        var counter = Counter;
+                        var changed = direction != Direction;
+                        Direction = direction;
+                        if(changed)
+                        {
+                            Counter = counter;
+                        }
                     }, valueProviderCallback: _ => Direction == Direction.Descending, name: "Direction (DIR)")
                     .WithEnumField(5, 2, out centerAlignedMode, name: "Center-aligned mode selection (CMS)")
                     .WithFlag(7, out autoReloadPreloadEnable, name: "Auto-reload preload enable (APRE)")
@@ -275,7 +284,7 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                         }
                         else if(Direction == Direction.Descending)
                         {
-                            Value = autoReloadValue;
+                            Counter = autoReloadValue;
                         }
 
                         repetitionsLeft = (uint)repetitionCounter.Value;
@@ -323,14 +332,14 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                 },
                 {(long)Registers.Counter, new DoubleWordRegister(this)
                     .WithValueField(0, timerCounterLengthInBits,
-                        writeCallback: (_, val) => Value = val,
+                        writeCallback: (_, val) => Counter = val,
                         valueProviderCallback: _ =>
                         {
                             if(sysbus.TryGetCurrentCPU(out var cpu))
                             {
                                 cpu.SyncTime();
                             }
-                            return (uint)Value;
+                            return (uint)Counter;
                         }, name: "Counter value (CNT)")
                     .WithReservedBits(timerCounterLengthInBits, 32 - timerCounterLengthInBits)
                     .WithWriteCallback((_, val) =>
@@ -364,7 +373,7 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                         Enabled = enableRequested && autoReloadValue > 0;
                         if(!autoReloadPreloadEnable.Value)
                         {
-                            Limit = autoReloadValue;
+                            Limit = (ulong)autoReloadValue + 1;
                         }
                     }, valueProviderCallback: _ => autoReloadValue, name: "Auto-reload value (ARR)")
                     .WithReservedBits(timerCounterLengthInBits, 32 - timerCounterLengthInBits)
@@ -558,7 +567,7 @@ public override void Reset()
             registers.Reset();
             autoReloadValue = initialLimit;
             enableRequested = false;
-            Limit = initialLimit;
+            Limit = (ulong)initialLimit + 1;
             repetitionsLeft = 0;
             updateInterruptFlag = false;
             for(var i = 0; i < NumberOfCCChannels; ++i)
@@ -774,6 +783,29 @@ private void UpdateInterrupts()
 
         private bool IsTriggerMode => slaveModeSelection.Value == SlaveModeSelection.TriggerMode;
 
+        // The counter (TIMx_CNT). It counts ARR + 1 values per period, so an update event comes every
+        // (ARR + 1) * (PSC + 1) timer clocks: up, from 0 to ARR, overflowing to 0; down, from ARR to 0,
+        // underflowing to ARR. The clock entry's limit is ARR + 1 and reaching it is the overflow or
+        // underflow: counting up, the entry's value is the counter (0 to ARR); counting down, it is
+        // the counter + 1 (ARR + 1 to 1), since a descending entry fires when its value reaches 0.
+        private ulong Counter
+        {
+            get
+            {
+                if(Direction == Direction.Descending)
+                {
+                    var value = Value;
+                    return value > 0 ? value - 1 : 0;
+                }
+                return Value;
+            }
+
+            set
+            {
+                Value = Direction == Direction.Descending ? value + 1 : value;
+            }
+        }
+
         private uint autoReloadValue;
         private uint repetitionsLeft;
         private bool updateInterruptFlag;
diff --git a/src/Emulator/Peripherals/Test/PeripheralsTests/STM32_TimerTests.cs b/src/Emulator/Peripherals/Test/PeripheralsTests/STM32_TimerTests.cs
new file mode 100644
index 0000000..52774ce
--- /dev/null
+++ b/src/Emulator/Peripherals/Test/PeripheralsTests/STM32_TimerTests.cs
@@ -0,0 +1,159 @@
+//
