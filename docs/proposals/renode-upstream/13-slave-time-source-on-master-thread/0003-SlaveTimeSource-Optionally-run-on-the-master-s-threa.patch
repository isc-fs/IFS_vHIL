+        /// <summary>
+        /// Whether this slave runs on its master's thread instead of a dispatcher thread of its own.
+        /// </summary>
+        /// <remarks>
+        /// The master begins the slave's iteration when it grants the slave time (granting it to the slave's sinks in turn) and ends it
+        /// when it waits for the slave (waiting for them, then the slave's sync phase), so the slave's sinks run beside the master's other
+        /// sinks as they would with a thread, without a thread hand-off between the master and the slave every quantum.
+        /// Set it before the slave is attached to a master (<see cref="TimeHandle">).
+        /// </remarks>
+        public bool RunsOnMasterThread { get; set; }
+
         /// <see cref="ITimeSource.Domain">
         /// <remarks>
         /// If this slave is not attached to any master time source, the domain is null.
@@ -128,7 +139,11 @@ private void HandleStartRequest()
             lock(locker)
             {
                 this.Trace();
-                if(dispatcherThread == null)
+                if(RunsOnMasterThread)
+                {
+                    StartDispatcher();
+                }
+                else if(dispatcherThread == null)
                 {
                     this.Trace();
                     // if the dispatcher is not started yet - start it
@@ -249,10 +264,110 @@ private bool DispatchInner()
             return true;
         }
 
+        /// <summary>
+        /// The first half of an iteration of <see cref="DispatchInner"> on the master's thread: the master has just granted time to
+        /// (or wants to unblock) this slave's handle. Requests it and grants it to this slave's sinks, without waiting for them.
+        /// </summary>
+        internal void BeginOnMasterThread()
+        {
+            onMasterThreadExecuting = false;
+            if(!onMasterThreadActive)
+            {
+                return;
+            }
+            var previousTimeStamp = TimeDomainsManager.Instance.SwapCurrentThread(timeStampOnMasterThread);
+            try
+            {
+                if(!TimeHandle.RequestTimeInterval(out var intervalGranted, noWait: true))
+                {
+                    this.Trace("Time interval request interrupted");
+                    return;
+                }
+
+                if(isPaused)
+                {
+                    this.Trace("Handle paused");
+                    TimeHandle.ReportBackAndBreak(intervalGranted);
+                    return;
+                }
+
+                onMasterThreadTimeLeft = intervalGranted;
+                if(waitingForSlave || (onMasterThreadTimeLeft >= Quantum && isStarted))
+                {
+                    waitingForSlave = false;
+                    InnerExecuteBegin();
+                    onMasterThreadExecuting = true;
+                }
+                else
+                {
+                    TimeHandle.ReportBackAndContinue(onMasterThreadTimeLeft);
+                }
+            }
+            finally
+            {
+                TimeDomainsManager.Instance.SwapCurrentThread(previousTimeStamp);
+            }
+        }
+
+        /// <summary>
+        /// The second half, when the master waits for this slave's handle: waits for this slave's sinks, runs its sync phase and reports
+        /// back to the master, as <see cref="DispatchInner"> does.
+        /// </summary>
+        internal void EndOnMasterThread()
+        {
+            if(!onMasterThreadExecuting)
+            {
+                return;
+            }
+            onMasterThreadExecuting = false;
+            var previousTimeStamp = TimeDomainsManager.Instance.SwapCurrentThread(timeStampOnMasterThread);
+            try
+            {
+                var syncPointReached = InnerExecuteEnd(out var elapsed);
+                onMasterThreadTimeLeft -= elapsed;
+                // A grant longer than a quantum (a residuum carried over): the rest as DispatchInner runs it, one quantum after another.
+                while(syncPointReached && onMasterThreadTimeLeft >= Quantum && isStarted)
+                {
+                    syncPointReached = InnerExecute(out elapsed);
+                    onMasterThreadTimeLeft -= elapsed;
+                }
+                if(!syncPointReached)
+                {
+                    // we should not ask for time grant since the current one is not finished yet
+                    waitingForSlave = true;
+                    TimeHandle.ReportBackAndBreak(onMasterThreadTimeLeft);
+                    return;
+                }
+                TimeHandle.ReportBackAndContinue(onMasterThreadTimeLeft);
+            }
+            finally
+            {
+                TimeDomainsManager.Instance.SwapCurrentThread(previousTimeStamp);
+            }
+        }
+
         private void StartDispatcher()
         {
             lock(locker)
             {
+                if(RunsOnMasterThread && TimeHandle != null)
+                {
+                    // What Dispatch's usings do for its thread's life, for as long as the slave is attached and started.
+                    isStarted = true;
+                    if(!onMasterThreadActive)
+                    {
+                        onMasterThreadActive = true;
+                        timeStampOnMasterThread = () => new TimeStamp(TimeHandle.TimeSource.NearestSyncPoint, TimeHandle.TimeSource.Domain);
+                        sourceActiveOnMasterThread = ObtainSourceActiveState();
+                        sinkActiveOnMasterThread = this.ObtainSinkActiveState();
+                    }
+                    else
+                    {
+                        // a start request: what a new dispatcher thread's ObtainSourceActiveState would do
+                        ActivateSlavesSourceSide();
+                    }
+                    return;
+                }
                 if(dispatcherThread != null || TimeHandle == null)
                 {
                     return;
@@ -270,6 +385,14 @@ private void StopDispatcher()
             lock(locker)
             {
                 isStarted = false;
+                if(onMasterThreadActive)
+                {
+                    onMasterThreadActive = false;
+                    onMasterThreadExecuting = false;
+                    sinkActiveOnMasterThread?.Dispose();
+                    sourceActiveOnMasterThread?.Dispose();
+                    sinkActiveOnMasterThread = sourceActiveOnMasterThread = null;
+                }
                 if(dispatcherThread != null && Thread.CurrentThread.ManagedThreadId != dispatcherThread.ManagedThreadId)
                 {
                     threadToJoin = dispatcherThread;
@@ -287,6 +410,18 @@ private void HandleTimePassed(TimeInterval diff)
         private Thread dispatcherThread;
         private TimeHandle timeHandle;
         private bool waitingForSlave;
+        // RunsOnMasterThread: the master's thread's iteration of this slave
+        [Transient]
