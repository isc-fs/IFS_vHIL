+        /// <summary>
+        /// Replaces the current thread's time stamp provider with <paramref name="f"/> (none if null) and returns the one it had (null if none),
+        /// for code that runs another time source's work on this thread for a while; swap the returned one back afterwards.
+        /// </summary>
+        public Func<TimeStamp> SwapCurrentThread(Func<TimeStamp> f)
+        {
+            var id = Thread.CurrentThread.ManagedThreadId;
+            timeGetters.TryGetValue(id, out var previous);
+            if(f == null)
+            {
+                timeGetters.TryRemove(id, out var unused);
+            }
+            else
+            {
+                timeGetters[id] = f;
+            }
+            return previous;
+        }
+
