From bc85f3f68791cffb8d26405b0ef7d4fc84cfdc7e Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Wed, 14 Oct 2026 02:33:04 +0200
Subject: [PATCH 2/2] SystemBus: Look up tags without allocating a closure

Every bus access calls TryGetTag, whose Misc.BinarySearch call
allocates a closure capturing the address. Search the tags with the
same algorithm in a static method instead: same comparisons, same
result.
---
 .../Main/Peripherals/Bus/SystemBus.cs         | 27 ++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/Emulator/Main/Peripherals/Bus/SystemBus.cs b/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
index 743efdaea..20b21a3d4 100644
--- a/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
+++ b/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
@@ -1589,6 +1589,31 @@ private static MappedSegmentWrapper FromRegistrationPointToSegmentWrapper(IMappe
             return new MappedSegmentWrapper(segment, registrationPoint.Range.StartAddress - registrationPoint.Offset, desiredSize, context);
         }
 
+        // Misc.BinarySearch(r => address.CompareTo(r.StartAddress)) without allocating its closure: every bus access looks up the tags
+        private static int FindTagIndex(IList<Range> tagRanges, ulong address)
+        {
+            var first = 0;
+            var last = tagRanges.Count;
+            while(first != last)
+            {
+                var idx = (first + last) / 2;
+                var comparison = address.CompareTo(tagRanges[idx].StartAddress);
+                if(comparison < 0)
+                {
+                    last = idx;
+                }
+                else if(comparison > 0)
+                {
+                    first = idx + 1;
+                }
+                else
+                {
+                    return idx;
+                }
+            }
+            return ~first;
+        }
+
         private Dictionary<string, List<StateMask>> ParseNewConditions(string newCondition)
         {
             if(string.IsNullOrEmpty(newCondition))
@@ -2481,7 +2506,7 @@ private bool RemoveMappingsForPeripheral(IBusPeripheral peripheral, ICPU context
 
         private bool TryGetTag(ulong address, out TagEntry? foundTag)
         {
-            var tagIdx = tags.Keys.BinarySearch(r => address.CompareTo(r.StartAddress));
+            var tagIdx = FindTagIndex(tags.Keys, address);
             if(tagIdx >= 0)
             {
                 // Direct hit - the address is the start address of a tag
