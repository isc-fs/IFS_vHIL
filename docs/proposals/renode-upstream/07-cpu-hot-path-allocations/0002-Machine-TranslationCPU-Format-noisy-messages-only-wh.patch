From d1f543219806c360c51e89816bfab81e7ccfea3c Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Wed, 14 Oct 2026 02:36:24 +0200
Subject: [PATCH 2/2] Machine, TranslationCPU: Format noisy messages only when
 they are logged

Machine.ScheduleAction's handler boxes its two TimeIntervals for a
noisy message on every scheduled action, and the opcode execution hook
handlers format an interpolated string for every hooked instruction,
before Logger.LogAs drops the message at any level above Noisy. Check
Logger.MinimumLogLevel first, as PL330_DMA already does. The output is
the same.
---
 src/Emulator/Main/Core/Machine.cs                    |  6 +++++-
 .../CPU/TranslationCPU_OpcodesExecutionHooks.cs      | 12 ++++++++++--
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/Emulator/Main/Core/Machine.cs b/src/Emulator/Main/Core/Machine.cs
index d7e366ca8..2a01c83ba 100644
--- a/src/Emulator/Main/Core/Machine.cs
+++ b/src/Emulator/Main/Core/Machine.cs
@@ -628,7 +628,11 @@ public void ScheduleAction(TimeInterval delay, Action<TimeInterval> action, stri
             Action clockEntryHandler = null;
             clockEntryHandler = () =>
             {
-                this.Log(LogLevel.Noisy, "{0}: Executing action scheduled at {1} (current time: {2})", name ?? "unnamed", startTime, currentTime);
+                // Boxing the times allocates on every scheduled action, even when the message is dropped
+                if(Logger.MinimumLogLevel <= LogLevel.Noisy)
+                {
+                    this.Log(LogLevel.Noisy, "{0}: Executing action scheduled at {1} (current time: {2})", name ?? "unnamed", startTime, currentTime);
+                }
                 action(currentTime);
                 if(!ClockSource.TryRemoveClockEntry(clockEntryHandler))
                 {
diff --git a/src/Emulator/Peripherals/Peripherals/CPU/TranslationCPU_OpcodesExecutionHooks.cs b/src/Emulator/Peripherals/Peripherals/CPU/TranslationCPU_OpcodesExecutionHooks.cs
index be0d48101..8f5e7a7b0 100644
--- a/src/Emulator/Peripherals/Peripherals/CPU/TranslationCPU_OpcodesExecutionHooks.cs
+++ b/src/Emulator/Peripherals/Peripherals/CPU/TranslationCPU_OpcodesExecutionHooks.cs
@@ -74,7 +74,11 @@ private void CheckArchitectureForOpcodeExecutionHooks()
         [Export]
         private void HandlePreOpcodeExecutionHook(UInt32 id, UInt64 pc, UInt64 opcode)
         {
-            this.NoisyLog($"Got pre-opcode hook for opcode `0x{opcode:X}` with id {id} from PC {pc}");
+            // Called for every hooked instruction: format the message only if it can be logged
+            if(Logger.MinimumLogLevel <= LogLevel.Noisy)
+            {
+                this.NoisyLog($"Got pre-opcode hook for opcode `0x{opcode:X}` with id {id} from PC {pc}");
+            }
             if(id < (uint)preOpcodeExecutionHooks.Count)
             {
                 preOpcodeExecutionHooks[(int)id].Invoke(pc, opcode);
@@ -88,7 +92,11 @@ private void HandlePreOpcodeExecutionHook(UInt32 id, UInt64 pc, UInt64 opcode)
         [Export]
         private void HandlePostOpcodeExecutionHook(UInt32 id, UInt64 pc, UInt64 opcode)
         {
-            this.NoisyLog($"Got post-opcode hook for opcode `0x{opcode:X}` with id {id} from PC {pc}");
+            // Called for every hooked instruction: format the message only if it can be logged
+            if(Logger.MinimumLogLevel <= LogLevel.Noisy)
+            {
+                this.NoisyLog($"Got post-opcode hook for opcode `0x{opcode:X}` with id {id} from PC {pc}");
+            }
             if(id < (uint)postOpcodeExecutionHooks.Count)
             {
                 postOpcodeExecutionHooks[(int)id].Invoke(pc, opcode);
