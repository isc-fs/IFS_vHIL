From 74c8ac901d59885281f5e69a1ffb34ce79d13c93 Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Wed, 14 Oct 2026 18:00:16 +0200
Subject: [PATCH 2/2] ClockSource: Compute clock entry updates in integers when
 exact

The two update handlers did each enabled entry's tick arithmetic in
Fraction, with a GCD or LCM in almost every operation, on every clock
source update. For an entry whose ratio is p/q and whose residuum is a
multiple of 1/q (always, unless the entry's step changed), with every
operand below 2^31, compute the same values in integers: the entry
ticks are x/q with x = ticks * p + residuum * q, the new residuum
(x % q)/q, reduced as Fraction reduces it, and the emulator ticks to the
limit one division by p, rounded up as before. Every Fraction involved
is reduced and nothing overflows in that range, so the entry, its
residuum and the nearest limit are the same values in the same form;
anything else takes the Fraction path.
---
 src/Emulator/Main/Time/BaseClockSource.cs | 92 +++++++++++++++++++++++
 1 file changed, 92 insertions(+)

diff --git a/src/Emulator/Main/Time/BaseClockSource.cs b/src/Emulator/Main/Time/BaseClockSource.cs
index 7af986af1..f9c6629dd 100644
--- a/src/Emulator/Main/Time/BaseClockSource.cs
+++ b/src/Emulator/Main/Time/BaseClockSource.cs
@@ -281,8 +281,79 @@ public bool HasEntries
 
         public event Action<int, int> NumberOfEntriesChanged;
 
+        // The Fraction arithmetic of the two handlers below, in integers, for an entry whose ratio is p/q and
+        // whose residuum is a multiple of 1/q (every residuum is, unless the entry's step changed): the entry
+        // ticks in `emulatorTicks` are x/q with x = emulatorTicks * p + residuum * q, of which x / q are whole
+        // and (x % q)/q is the new residuum. Every Fraction the handlers compute is reduced, and with no operand
+        // reaching 2^31 nothing overflows on either path, so this gives the same values in the same form,
+        // without the GCDs and LCMs of the Fraction operations. Returns false for anything else.
+        private static bool TryGetEntryTicks(ref ClockEntry entry, ulong emulatorTicks, out ulong wholeTicks, out ulong remainder, out ulong p, out ulong q)
+        {
+            var ratio = entry.Ratio;
+            var residuum = entry.ValueResiduum;
+            p = ratio.Numerator;
+            q = ratio.Denominator;
+            wholeTicks = 0;
+            remainder = 0;
+            if(p == 0 || ratio.Minus || residuum.Minus
+                || (p | q | emulatorTicks | entry.Period | entry.Value) >= IntegerArithmeticOperandLimit)
+            {
+                return false;
+            }
+            var scaledResiduum = 0UL;
+            if(residuum.Numerator != 0)
+            {
+                if(q % residuum.Denominator != 0)
+                {
+                    return false;
+                }
+                scaledResiduum = residuum.Numerator * (q / residuum.Denominator);
+            }
+            var x = emulatorTicks * p + scaledResiduum;
+            wholeTicks = x / q;
+            remainder = x % q;
+            return true;
+        }
+
+        private static Fraction Residuum(ulong remainder, ulong q)
+        {
+            return remainder == 0 ? Fraction.Zero : new Fraction(remainder, q);
+        }
+
+        // Emulator ticks until d/q entry ticks pass at the ratio p/q, rounded up as the handlers round
+        // the Fraction (d/q) / (p/q) up.
+        private static ulong WholeTicksToLimit(ulong d, ulong p)
+        {
+            var wholeTicksToLimit = d / p;
+            if(wholeTicksToLimit < uint.MaxValue && d % p != 0)
+            {
+                wholeTicksToLimit += 1;
+            }
+            return wholeTicksToLimit;
+        }
+
         private static bool HandleDirectionDescendingPositiveRatio(ref ClockEntry entry, TimeInterval time, ref TimeInterval nearestTickIn)
         {
+            if(TryGetEntryTicks(ref entry, time.Ticks, out var wholeTicks, out var remainder, out var p, out var q))
+            {
+                var reached = wholeTicks >= entry.Value;
+                if(reached)
+                {
+                    entry.Value = entry.Period;
+                    entry.ValueResiduum = Fraction.Zero;
+                    entry = entry.With(enabled: entry.Enabled & (entry.WorkMode != WorkMode.OneShot));
+                    remainder = 0;
+                }
+                else
+                {
+                    entry.Value -= wholeTicks;
+                    entry.ValueResiduum = Residuum(remainder, q);
+                }
+                // (Value - residuum) / ratio, with Value > 0 or no residuum
+                nearestTickIn = nearestTickIn.WithTicksMin(WholeTicksToLimit(entry.Value * q - remainder, p));
+                return reached;
+            }
+
             var emulatorTicks = time.Ticks;
             var entryTicks = emulatorTicks * entry.Ratio + entry.ValueResiduum;
             var isReached = entryTicks.Integer >= entry.Value;
@@ -310,6 +381,24 @@ private static bool HandleDirectionDescendingPositiveRatio(ref ClockEntry entry,
 
         private static bool HandleDirectionAscendingPositiveRatio(ref ClockEntry entry, TimeInterval time, ref TimeInterval nearestTickIn)
         {
+            if(TryGetEntryTicks(ref entry, time.Ticks, out var wholeTicks, out var remainder, out var p, out var q))
+            {
+                var reached = false;
+                entry.Value += wholeTicks;
+                entry.ValueResiduum = Residuum(remainder, q);
+                if(entry.Value >= entry.Period)
+                {
+                    reached = true;
+                    entry.Value = 0;
+                    entry.ValueResiduum = Fraction.Zero;
+                    entry = entry.With(enabled: entry.Enabled & (entry.WorkMode != WorkMode.OneShot));
+                    remainder = 0;
+                }
+                // (Period - Value - residuum) / ratio, with Value < Period
+                nearestTickIn = nearestTickIn.WithTicksMin(WholeTicksToLimit((entry.Period - entry.Value) * q - remainder, p));
+                return reached;
+            }
+
             var emulatorTicks = time.Ticks;
             var entryTicks = emulatorTicks * entry.Ratio + entry.ValueResiduum;
             var isReached = false;
@@ -465,6 +554,9 @@ private void UpdateUpdateHandler(int clockEntryIndex)
         private readonly List<TimeInterval> unaccountedTimes;
         private readonly object sync;
 
+        // Below this, a product of two operands of TryGetEntryTicks plus a third stays below 2^63
+        private const ulong IntegerArithmeticOperandLimit = 1UL << 31;
+
         private delegate bool UpdateHandlerDelegate(ref ClockEntry entry, TimeInterval time, ref TimeInterval nearestTickIn);
     }
 }
\ No newline at end of file
