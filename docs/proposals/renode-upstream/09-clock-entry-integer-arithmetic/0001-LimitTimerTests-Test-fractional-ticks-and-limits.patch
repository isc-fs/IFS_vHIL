From a970a910a31d52bab01e086f0813a1fd5793e584 Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Wed, 14 Oct 2026 18:00:16 +0200
Subject: [PATCH 1/2] LimitTimerTests: Test fractional ticks and limits

Timers whose frequency doesn't divide the emulator's tick rate count in
fractions of a tick (ClockEntry.ValueResiduum) and reach their limit
between two emulator ticks. Check the value after each of many uneven
advances, in both directions, and that the timer goes off on the first
emulator tick after its limit, for operands below and above 2^31.
---
 .../Main/Tests/UnitTests/LimitTimerTests.cs   | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/src/Emulator/Main/Tests/UnitTests/LimitTimerTests.cs b/src/Emulator/Main/Tests/UnitTests/LimitTimerTests.cs
index 21dab0ddd..e5928ff13 100644
--- a/src/Emulator/Main/Tests/UnitTests/LimitTimerTests.cs
+++ b/src/Emulator/Main/Tests/UnitTests/LimitTimerTests.cs
@@ -126,6 +126,49 @@ public void ShouldSwitchDirectionProperly()
             Assert.IsTrue(ticked);
         }
 
+        [Test]
+        public void ShouldCarryFractionalTicksAscending([Values(3000000UL, 32768UL)] ulong frequency, [Values(1234567UL, 3000001UL)] ulong step,
+            [Values(1000000000UL, 1UL << 40)] ulong limit)
+        {
+            var mockClockSource = new MockClockSource();
+            var timer = new LimitTimer(mockClockSource, frequency, null, String.Empty, limit, Direction.Ascending, true);
+            for(var i = 1UL; i <= 100; i++)
+            {
+                mockClockSource.AdvanceByNanoseconds(step);
+                Assert.AreEqual(i * step * frequency / TimeInterval.TicksPerSecond, timer.Value, "Timer value is not expected.");
+            }
+        }
+
+        [Test]
+        public void ShouldCarryFractionalTicksDescending([Values(3000000UL, 32768UL)] ulong frequency, [Values(1234567UL, 3000001UL)] ulong step,
+            [Values(1000000000UL, 1UL << 40)] ulong limit)
+        {
+            var mockClockSource = new MockClockSource();
+            var timer = new LimitTimer(mockClockSource, frequency, null, String.Empty, limit, Direction.Descending, true);
+            for(var i = 1UL; i <= 100; i++)
+            {
+                mockClockSource.AdvanceByNanoseconds(step);
+                Assert.AreEqual(limit - i * step * frequency / TimeInterval.TicksPerSecond, timer.Value, "Timer value is not expected.");
+            }
+        }
+
+        [Test]
+        public void ShouldFireAtTheFractionalLimit([Values(3000000UL, 32768UL)] ulong frequency, [Values(1000UL, (1UL << 31) + 1000)] ulong limit)
+        {
+            // At a frequency that doesn't divide the emulator's tick rate the limit is reached between two
+            // emulator ticks: the timer must go off on the first tick after it, not before
+            var ticksToLimit = (limit * TimeInterval.TicksPerSecond + frequency - 1) / frequency;
+            var activationCounter = 0;
+            var mockClockSource = new MockClockSource();
+            var timer = new LimitTimer(mockClockSource, frequency, null, String.Empty, limit, Direction.Ascending, true, eventEnabled: true);
+            timer.LimitReached += () => activationCounter++;
+            mockClockSource.AdvanceByNanoseconds(ticksToLimit - 1);
+            Assert.AreEqual(0, activationCounter, "Timer went off too early.");
+            mockClockSource.AdvanceByNanoseconds(1);
+            Assert.AreEqual(1, activationCounter, "Timer did not go off.");
+            Assert.AreEqual(0, timer.Value, "Timer value is not expected.");
+        }
+
         [Test]
         public void ShouldNotFireAlarmWhenInterruptsAreDisabled()
         {
