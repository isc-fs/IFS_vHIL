# Renode's two-node demo scripts/multi-node/nrf52840-ble-zephyr.resc (Zephyr's
# BLE heart-rate central and peripheral on two nRF52840s, a BLE medium, the
# demo's 10 us quantum), run headless, with its `mach create`s replaced by
# add_machine (TIMESOURCE: see _machines.resc). Both machines idle in WFI
# most of the time, so the 100,000 quanta per virtual second dominate.
$warmup?="1"
$measure?="5"
$central_bin?=@https://dl.antmicro.com/projects/renode/nrf52840--zephyr-bluetooth_central_hr.elf-s_3380332-316e27f81dcda3c2b0e7f2c3516001e7b27ad051
$peripheral_bin?=@https://dl.antmicro.com/projects/renode/nrf52840--zephyr-bluetooth_peripheral_hr.elf-s_3217940-7b59adc9629f8be90067b131e663a13d2d4bb711
include $ORIGIN/_machines.resc
using sysbus
emulation CreateBLEMedium "wireless"
python "add_machine('central')"
mach set "central"
machine LoadPlatformDescription @platforms/cpus/nrf52840.repl
connector Connect sysbus.radio wireless
python "add_machine('peripheral')"
mach set "peripheral"
machine LoadPlatformDescription @platforms/cpus/nrf52840.repl
connector Connect sysbus.radio wireless
emulation SetGlobalQuantum "0.00001"
mach set "central"
sysbus LoadELF $central_bin
mach set "peripheral"
sysbus LoadELF $peripheral_bin
include $ORIGIN/_measure.resc
