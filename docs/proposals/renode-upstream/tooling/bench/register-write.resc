# A loop toggling one field of STM32_GPIOPort's OSPEEDR: the bus access path
# plus the register framework's write, one field changing per write.
$warmup?="0.05"
$measure?="0.25"
mach create
machine LoadPlatformDescriptionFromString """
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
rom: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000
gpio: GPIOPort.STM32_GPIOPort @ sysbus <0x40020000, +0x400>
"""
cpu PerformanceInMips 100
cpu AssembleBlock 0 """
ldr r0, =0x40020008
movs r1, #0
loop:
str r1, [r0]
eor r1, r1, #1
b loop
"""
cpu PC 0
include $ORIGIN/_measure.resc
