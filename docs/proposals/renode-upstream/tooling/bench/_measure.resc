# Included by every benchmark after its setup: warm up (JIT tiering), then run
# $measure of virtual time and print the host wall time it took, the bytes the
# process allocated and the gen-0 collections, from .NET's own counters.
# Idle CPUs don't wait for the host clock: by default an idle demo runs at
# real time at most.
emulation SetGlobalAdvanceImmediately true
emulation RunFor $warmup
python "import time; from System import GC; a0 = GC.GetTotalAllocatedBytes(False); g0 = GC.CollectionCount(0); t0 = time.time()"
emulation RunFor $measure
python "w = time.time() - t0; print('BENCH wall=%.4f alloc=%d gen0=%d' % (w, GC.GetTotalAllocatedBytes(False) - a0, GC.CollectionCount(0) - g0))"
quit
