+        [Test]
+        public void ShouldFindEveryEntryByHandlerAfterAddingAndRemovingEntries()
+        {
+            var clockSource = new BaseClockSource();
+            var handlers = new Action[10];
+            var calls = new int[handlers.Length];
+            for(var i = 0; i < handlers.Length; i++)
+            {
+                // Capture the index: every non-capturing lambda here would be the same cached delegate
+                var index = i;
+                handlers[i] = () => calls[index]++;
+                clockSource.AddClockEntry(new ClockEntry((ulong)(100 + i), 1, handlers[i], null, String.Empty));
+            }
+
+            Assert.IsTrue(clockSource.TryRemoveClockEntry(handlers[3]));
+            Assert.IsTrue(clockSource.TryRemoveClockEntry(handlers[0]));
+            Assert.IsTrue(clockSource.TryRemoveClockEntry(handlers[9]));
+            Assert.IsFalse(clockSource.TryRemoveClockEntry(handlers[3]));
+            clockSource.AddClockEntry(new ClockEntry(103, 1, handlers[3], null, String.Empty));
+            clockSource.ExchangeClockEntryWith(handlers[5], entry => entry.With(period: 205), null);
+
+            for(var i = 0; i < handlers.Length; i++)
+            {
+                if(i == 0 || i == 9)
+                {
+                    Assert.Throws<KeyNotFoundException>(() => clockSource.GetClockEntry(handlers[i]));
+                    continue;
+                }
+                Assert.AreEqual(i == 5 ? 205 : 100 + i, clockSource.GetClockEntry(handlers[i]).Period);
+                Assert.Throws<ArgumentException>(() => clockSource.AddClockEntry(new ClockEntry(1, 1, handlers[i], null, String.Empty)));
+            }
+            CollectionAssert.AreEqual(new[] { 1, 2, 4, 5, 6, 7, 8, 3 }.Select(i => handlers[i]), clockSource.GetAllClockEntries().Select(x => x.Handler));
+        }
+
