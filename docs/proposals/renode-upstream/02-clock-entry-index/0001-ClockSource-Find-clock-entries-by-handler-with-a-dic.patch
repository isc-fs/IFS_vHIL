+        // Clock entries are looked up by their handler on every timer reload or read (GetClockEntry,
+        // ExchangeClockEntryWith) and twice for every Machine.ScheduleAction: keep the index of each
+        // handler's first entry, which is what a linear search of clockEntries would find.
+        private int IndexOfHandler(Action handler)
+        {
+            if(handler == null)
+            {
+                // Not indexed (a dictionary key can't be null)
+                return clockEntries.FindIndex(x => x.Handler == null);
+            }
+            return indexByHandler.TryGetValue(handler, out var index) ? index : -1;
+        }
+
+        private void AddEntry(ClockEntry entry)
+        {
+            clockEntries.Add(entry);
+            clockEntriesUpdateHandlers.Add(null);
+            unaccountedTimes.Add(TimeInterval.Empty);
+            if(entry.Handler != null && !indexByHandler.ContainsKey(entry.Handler))
+            {
+                indexByHandler[entry.Handler] = clockEntries.Count - 1;
+            }
+            UpdateUpdateHandler(clockEntries.Count - 1);
+        }
+
+        private void SetEntry(int index, ClockEntry entry)
+        {
+            var oldHandler = clockEntries[index].Handler;
+            clockEntries[index] = entry;
+            if(oldHandler != entry.Handler)
+            {
+                RebuildIndex();
+            }
+        }
+
+        private void RemoveEntryAt(int index)
+        {
+            var removedHandler = clockEntries[index].Handler;
+            clockEntries.RemoveAt(index);
+            clockEntriesUpdateHandlers.RemoveAt(index);
+            unaccountedTimes.RemoveAt(index);
+            // The entries after the removed one move down by one
+            for(var i = index; i < clockEntries.Count; i++)
+            {
+                var handler = clockEntries[i].Handler;
+                if(handler != null && indexByHandler.TryGetValue(handler, out var oldIndex) && oldIndex == i + 1)
+                {
+                    indexByHandler[handler] = i;
+                }
+            }
+            if(removedHandler != null && indexByHandler.TryGetValue(removedHandler, out var removedIndex) && removedIndex == index)
+            {
+                // Point at the handler's next entry, if it has one
+                indexByHandler.Remove(removedHandler);
+                var next = clockEntries.FindIndex(index, x => x.Handler == removedHandler);
+                if(next != -1)
+                {
+                    indexByHandler[removedHandler] = next;
+                }
+            }
+        }
+
+        private void RebuildIndex()
+        {
+            indexByHandler.Clear();
+            for(var i = 0; i < clockEntries.Count; i++)
+            {
+                var handler = clockEntries[i].Handler;
+                if(handler != null && !indexByHandler.ContainsKey(handler))
+                {
+                    indexByHandler[handler] = i;
+                }
+            }
+        }
+
