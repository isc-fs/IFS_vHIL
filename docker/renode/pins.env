# What docker/renode/build.sh builds: Renode at a release tag, every
# submodule at the commit that tag records (submodules.txt), and the patch
# queue in patches/ applied to renode-infrastructure. Each value is checked,
# not trusted: a mismatch fails the image build. README.md says how to move
# to a new release.

# The release, and the commit its tag points at
# (git ls-remote https://github.com/renode/renode "refs/tags/v<ver>*").
RENODE_VERSION=1.17.0
RENODE_COMMIT=ab721d88e135a1bcb8ed2ecc5a38f51cbe61fdd2

# renode-resources (prebuilt libraries the build links; build.sh would
# otherwise clone its master): the commit current when 1.17.0 was studied.
RENODE_RESOURCES_COMMIT=14b80cde0a136b684f316eb7f6a31aeaae0684bf

# The vHIL's patch set: bump the suffix whenever patches/ changes.
VHIL_PATCH_SET=1.17.0-vhil.8

# renode-infrastructure's tree (git write-tree) once patches/ is applied to
# the commit submodules.txt names for src/Infrastructure: the source the
# build compiles, byte for byte.
RENODE_INFRA_PATCHED_TREE=832a9d8fe7a2f2dfd92ec4cdd5b41e8ff58edbdc

# tlib's tree (git write-tree) once patches/tlib/ is applied to the commit
# submodules.txt names for src/Infrastructure/src/Emulator/Cores/tlib.
RENODE_TLIB_PATCHED_TREE=8464998ae64ee84356f3f7704c1be0c2d07adb28
