From 6b7eaa01d0d8cc3e01b2ed245286241e79d8f048 Mon Sep 17 00:00:00 2001
From: Raul Moran <rmg@raulmoranguerra.com>
Date: Wed, 14 Oct 2026 17:56:16 +0200
Subject: [PATCH] STM32_Timer: Leave unused compare channels alone on update
 events

The update event re-applied all four capture/compare channels' timers
every period: an Enabled and a Direction write each, i.e. two clock
entry exchanges (a new ClockEntry and a linear search each) and two
return requests. The event runs inside the clock source's update, where
an exchange only replaces the entry and asks for another pass, and the
auto-reload write before the loop has already asked for that pass and
for the return. For a channel with neither its interrupt nor its output
enabled, whose timer is disabled and counts in the parent's direction,
both writes put back the entry that is already there: skip them.
---
 .../Peripherals/Peripherals/Timers/STM32_Timer.cs | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs b/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
index 47a492f48..030694aa6 100644
--- a/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
+++ b/src/Emulator/Peripherals/Peripherals/Timers/STM32_Timer.cs
@@ -66,7 +66,7 @@ public STM32_Timer(IMachine machine, ulong frequency, uint initialLimit) : base(
                 for(var i = 0; i < NumberOfCCChannels; ++i)
                 {
                     var channel = channels[i];
-                    channel.UpdateTimer();
+                    channel.UpdateTimerOnUpdateEvent();
                     if(!channel.Timer.Enabled || !channel.IsOutputMode)
                     {
                         continue;
@@ -842,6 +842,19 @@ public void SetInput(bool value)
                 Signal = value;
             }
 
+            // Called on every update event, from the clock source's update, after the auto-reload write has
+            // already asked it for another pass and the CPU to return. A channel with neither its interrupt nor
+            // its output enabled, whose timer is disabled and counts in the parent's direction, would get the
+            // same clock entry back from UpdateTimer, so it is left as it is.
+            public void UpdateTimerOnUpdateEvent()
+            {
+                if(!IsInterruptOrOutputEnabled && !Timer.Enabled && Timer.Direction == parent.Direction)
+                {
+                    return;
+                }
+                UpdateTimer();
+            }
+
             public void UpdateTimer()
             {
                 Timer.Enabled = parent.Enabled && IsInterruptOrOutputEnabled && parent.Value < Timer.Limit;
