From 48245d7a6454326261365701ad9b3bed69e5e2a7 Mon Sep 17 00:00:00 2001
From: Raul Moran <moranguerra18@gmail.com>
Date: Wed, 14 Oct 2026 09:55:14 +0200
Subject: [PATCH] Exclude pre-opcode execution hooks at given addresses

tlib_exclude_pre_opcode_execution_hook(pc, hook_id) adds (pc, hook id) to
an open-addressed set (4096 slots, at most three quarters full, per tlib
instance) that generate_pre_opcode_execution_hook consults at translation
time: blocks translated afterwards no longer call that hook at that
address. tlib_clear_pre_opcode_execution_hook_exclusions empties it. An
empty set costs one compare per matching opcode at translation.
---
 arch/translate-all.c | 63 +++++++++++++++++++++++++++++++++++++++++++-
 exports.c            | 19 +++++++++++++
 include/exec-all.h   |  2 ++
 include/exports.h    |  2 ++
 4 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/arch/translate-all.c b/arch/translate-all.c
index cdb7d57..c420293 100644
--- a/arch/translate-all.c
+++ b/arch/translate-all.c
@@ -470,11 +470,72 @@ void generate_opcode_count_increment(CPUState *env, uint64_t opcode)
     }
 }
 
+/* Addresses where a pre-opcode execution hook is not generated: an open-addressed
+ * set of (pc, hook id) keys, per tlib instance (one per CPU). A hook's owner adds
+ * an address once it knows that the hook has nothing to do there, so blocks
+ * translated afterwards no longer call it at that address. */
+#define PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY 4096
+static uint64_t pre_opcode_hook_exclusions[PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY];
+static uint32_t pre_opcode_hook_exclusions_count;
+
+static inline uint64_t pre_opcode_hook_exclusion_key(uint64_t pc, uint32_t hook_id)
+{
+    /* 0 marks an empty slot. */
+    return ((pc << 3) | hook_id) + 1;
+}
+
+static inline uint32_t pre_opcode_hook_exclusion_slot(uint64_t key)
+{
+    return (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 52) & (PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY - 1);
+}
+
+static bool pre_opcode_hook_excluded(uint64_t pc, uint32_t hook_id)
+{
+    if(likely(pre_opcode_hook_exclusions_count == 0)) {
+        return false;
+    }
+    uint64_t key = pre_opcode_hook_exclusion_key(pc, hook_id);
+    for(uint32_t i = pre_opcode_hook_exclusion_slot(key);; i = (i + 1) & (PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY - 1)) {
+        if(pre_opcode_hook_exclusions[i] == key) {
+            return true;
+        }
+        if(pre_opcode_hook_exclusions[i] == 0) {
+            return false;
+        }
+    }
+}
+
+uint32_t pre_opcode_execution_hook_exclude(uint64_t pc, uint32_t hook_id)
+{
+    if(hook_id >= CPU_HOOKS_MASKS_LIMIT || (pc >> 60) != 0) {
+        return 0;
+    }
+    /* At most three quarters full, so a look-up always ends at an empty slot. */
+    if(pre_opcode_hook_excluded(pc, hook_id) ||
+       pre_opcode_hook_exclusions_count >= PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY / 4 * 3) {
+        return 0;
+    }
+    uint64_t key = pre_opcode_hook_exclusion_key(pc, hook_id);
+    uint32_t i = pre_opcode_hook_exclusion_slot(key);
+    while(pre_opcode_hook_exclusions[i] != 0) {
+        i = (i + 1) & (PRE_OPCODE_HOOK_EXCLUSIONS_CAPACITY - 1);
+    }
+    pre_opcode_hook_exclusions[i] = key;
+    pre_opcode_hook_exclusions_count++;
+    return 1;
+}
+
+void pre_opcode_execution_hook_exclusions_clear(void)
+{
+    memset(pre_opcode_hook_exclusions, 0, sizeof(pre_opcode_hook_exclusions));
+    pre_opcode_hook_exclusions_count = 0;
+}
+
 void generate_pre_opcode_execution_hook(CPUState *env, uint64_t pc, uint64_t opcode)
 {
     for(int hook_id = 0; hook_id < env->pre_opcode_execution_hooks_count; hook_id++) {
         opcode_hook_mask_t opcode_def = env->pre_opcode_execution_hook_masks[hook_id];
-        if((opcode & opcode_def.mask) == opcode_def.value) {
+        if((opcode & opcode_def.mask) == opcode_def.value && !pre_opcode_hook_excluded(pc, hook_id)) {
 
             TCGv_i32 tcg_hook_id = tcg_const_i32(hook_id);
             TCGv_i64 tcg_pc = tcg_const_i64(pc);
diff --git a/exports.c b/exports.c
index 7c212bf..fd05234 100644
--- a/exports.c
+++ b/exports.c
@@ -858,6 +858,25 @@ uint32_t tlib_install_pre_opcode_execution_hook(uint64_t mask, uint64_t value)
 
 EXC_INT_2(uint32_t, tlib_install_pre_opcode_execution_hook, uint64_t, mask, uint64_t, value)
 
+/* Blocks translated from now on don't call pre-opcode execution hook `hook_id` at
+ * `pc`; blocks already translated still do until they are invalidated. Returns 1
+ * if the address was added (0: already there, a bad id, or the set is full). */
+uint32_t tlib_exclude_pre_opcode_execution_hook(uint64_t pc, uint32_t hook_id)
+{
+    return pre_opcode_execution_hook_exclude(pc, hook_id);
+}
+
+EXC_INT_2(uint32_t, tlib_exclude_pre_opcode_execution_hook, uint64_t, pc, uint32_t, hook_id)
+
+/* Every address excluded with tlib_exclude_pre_opcode_execution_hook gets its
+ * hooks back in blocks translated from now on. */
+void tlib_clear_pre_opcode_execution_hook_exclusions(void)
+{
+    pre_opcode_execution_hook_exclusions_clear();
+}
+
+EXC_VOID_0(tlib_clear_pre_opcode_execution_hook_exclusions)
+
 void tlib_enable_post_opcode_execution_hooks(uint32_t value)
 {
     env->are_post_opcode_execution_hooks_enabled = !!value;
diff --git a/include/exec-all.h b/include/exec-all.h
index 3fcec27..664482e 100644
--- a/include/exec-all.h
+++ b/include/exec-all.h
@@ -383,6 +383,8 @@ void code_gen_free(void);
 
 void generate_opcode_count_increment(CPUState *, uint64_t);
 void generate_pre_opcode_execution_hook(CPUState *env, uint64_t pc, uint64_t opcode);
+uint32_t pre_opcode_execution_hook_exclude(uint64_t pc, uint32_t hook_id);
+void pre_opcode_execution_hook_exclusions_clear(void);
 void generate_post_opcode_execution_hook(CPUState *env, uint64_t pc, uint64_t opcode);
 void generate_stack_announcement_imm_i32(uint32_t addr, int type, bool clear_lsb);
 void generate_stack_announcement_imm_i64(uint64_t addr, int type, bool clear_lsb);
diff --git a/include/exports.h b/include/exports.h
index 714db21..d6d098c 100644
--- a/include/exports.h
+++ b/include/exports.h
@@ -106,6 +106,8 @@ uint64_t tlib_get_mmu_window_addend(uint64_t id);
 
 void tlib_enable_pre_opcode_execution_hooks(uint32_t value);
 uint32_t tlib_install_pre_opcode_execution_hook(uint64_t mask, uint64_t value);
+uint32_t tlib_exclude_pre_opcode_execution_hook(uint64_t pc, uint32_t hook_id);
+void tlib_clear_pre_opcode_execution_hook_exclusions(void);
 void tlib_enable_post_opcode_execution_hooks(uint32_t value);
 uint32_t tlib_install_post_opcode_execution_hook(uint64_t mask, uint64_t value);
 
-- 
