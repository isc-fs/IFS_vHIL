# Build context of docker/editor.Dockerfile (the repository root): only the
# editor's sources, never a local build's outputs.
*
!editor/pipeline-manager
editor/pipeline-manager/**/node_modules
editor/pipeline-manager/**/dist
editor/pipeline-manager/**/__pycache__
editor/pipeline-manager/**/.env.local
editor/pipeline-manager/pipeline_manager/frontend/src/vhil/shell
# The shell's tokens and fonts, which the editor's build takes from here.
!vhil/server/static/tokens.css
!vhil/server/static/fonts
